[Unit]
Description=Cérebro Bot Telegram + Scheduler
After=network.target

[Service]
Type=simple
User=cerebro
Group=cerebro
WorkingDirectory=/opt/cerebro
EnvironmentFile=/opt/cerebro/.env
ExecStart=/opt/cerebro/.venv/bin/python -m cerebro.main --telegram
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/cerebro/cerebro/db
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
