[Unit]
Description=Cérebro Deploy Webhook Listener
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/cerebro
EnvironmentFile=/opt/cerebro/.env
ExecStart=/opt/cerebro/.venv/bin/uvicorn deploy.listener:app --host 127.0.0.1 --port 9000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
