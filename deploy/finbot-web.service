[Unit]
Description=FinBot AI Dashboard
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/finbot
EnvironmentFile=/opt/finbot/.env.local
ExecStart=/usr/bin/node /opt/finbot/node_modules/.bin/next start -p 3000
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Limites
Environment=NODE_ENV=production
Environment=PORT=3000

[Install]
WantedBy=multi-user.target
