# ══════════════════════════════════════════════════════════════
# Cérebro — Variáveis de Ambiente
# ══════════════════════════════════════════════════════════════
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
#
# O .env está no .gitignore — nunca vai pro repositório.
# Se trocar de branch ou reinstalar, o .env permanece intacto.
# ══════════════════════════════════════════════════════════════

# ── OBRIGATÓRIO ──────────────────────────────────────────────

# Chave da API da Anthropic (Claude)
# Onde conseguir: https://console.anthropic.com/settings/keys
# Usada por: agente principal, workers de background
# Sem ela: nada que usa LLM funciona (só as funções determinísticas rodam)
ANTHROPIC_API_KEY=sk-ant-...

# ── SEGURANÇA ────────────────────────────────────────────────

# Chave de API para proteger endpoints de escrita (POST/PUT/DELETE)
# Gere uma chave aleatória: python -c "import secrets; print(secrets.token_hex(32))"
# Sem ela: API aceita qualquer request (dev mode) — OK se nginx basic auth está ativo
# Com ela: requests precisam do header X-API-Key ou query param ?api_key=
CEREBRO_API_KEY=

# ── TELEGRAM BOT ─────────────────────────────────────────────

# Token do bot do Telegram
# Onde conseguir: fale com @BotFather no Telegram → /newbot
# Usada por: interface Telegram (python -m cerebro.main --telegram)
# Sem ela: bot Telegram não funciona, mas CLI e dashboard web funcionam normal
TELEGRAM_BOT_TOKEN=

# IDs de usuários autorizados (separados por vírgula)
# Como descobrir seu ID: fale com @userinfobot no Telegram
# Exemplo: 123456789 ou 123456789,987654321 (para múltiplos)
# Sem ela: ninguém consegue usar o bot
TELEGRAM_AUTHORIZED_USERS=

# ── BRAVE SEARCH (opcional) ──────────────────────────────────

# Chave da API do Brave Search — permite o agente pesquisar na internet
# Onde conseguir: https://brave.com/search/api/ (tem plano gratuito: 2000 buscas/mês)
# Usada por: tool "buscar_web" do agente e worker de pesquisa
# Sem ela: o agente responde "busca web não configurada" quando tentar pesquisar
# Com ela: o agente pode pesquisar benchmarks, preços, concorrentes, etc.
# Exemplo de uso: "pesquisa o CPC médio do setor de máquinas pesadas"
BRAVE_API_KEY=

# ── GOOGLE CALENDAR (opcional) ───────────────────────────────

# Credenciais OAuth2 do Google Calendar
# Onde conseguir:
#   1. Acesse https://console.cloud.google.com
#   2. Crie um projeto (ou use existente)
#   3. Ative a API "Google Calendar API"
#   4. Vá em Credenciais → Criar credenciais → ID do cliente OAuth
#   5. Tipo: "Aplicativo para computador"
#   6. Baixe o JSON e salve no servidor
#   7. Na primeira execução, ele abre um link pra autorizar e gera o token.json
#
# Sem elas: calendário funciona local (SQLite), só não sincroniza com Google Calendar
# Com elas: eventos criados no Cérebro aparecem no Google Calendar do Matheus

# Caminho para o arquivo de credenciais OAuth (o JSON baixado do Google Cloud)
GOOGLE_CREDENTIALS_PATH=

# Caminho para o token gerado após autorização (criado automaticamente na 1ª vez)
GOOGLE_TOKEN_PATH=

# ── SUPABASE / FINBOT (opcional) ─────────────────────────────

# Integração com o FinBot AI (dashboard financeiro)
# Quando configurado, lançamentos feitos via Telegram/CLI aparecem no FinBot automaticamente.
#
# Onde conseguir:
#   1. Acesse https://supabase.com → seu projeto
#   2. Settings → API → copie "Project URL" e "service_role key"
#   3. O user_id é seu UUID na tabela profiles (SQL: SELECT id FROM profiles LIMIT 1)
#
# Sem elas: módulo financeiro funciona local (SQLite), sem sincronizar com FinBot
# Com elas: "gastei 45 no almoço" via Telegram aparece no dashboard do FinBot

# URL do projeto Supabase (ex: https://abcdefg.supabase.co)
SUPABASE_URL=

# Service Role Key (NÃO a anon key — a service_role bypassa RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Seu UUID de usuário na tabela profiles do Supabase
SUPABASE_USER_ID=

# URL onde o FinBot está rodando (pra link na nav do Cérebro)
# Ex: http://localhost:3000 ou https://finbot.seudominio.com
FINBOT_URL=
